---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import logo from '../images/logo.webp'
import menuPhoto from '../images/menu.webp'
import soupPhoto from '../images/soup.webp'
import marketStall from '../images/market-stall.webp'
import capreseSandwich from '../images/caprese-sandwich.webp'
import prosciuttoSandwich from '../images/prosciutto-sandwich.webp'
import sandwichTrio from '../images/sandwich-trio.webp'

const tickerWords = [
	'Focaccia',
	'Prosciutto',
	'Mozzarella',
	'Caprese',
	'Homemade',
	'Tuscan',
	'Fresh Daily',
	'Market Fresh',
]

const tickerContent = [...tickerWords, ...tickerWords]
---

<Layout>
	<!-- Hero + Ticker wrapper -->
	<div class="h-[calc(100svh-var(--header-height))] md:h-auto flex flex-col">
	<!-- Hero -->
	<section class="relative flex-1 md:min-h-[70vh] flex items-end overflow-hidden">
		<Image
			src={prosciuttoSandwich}
			alt="Fresh prosciutto focaccia sandwich close-up"
			class="absolute inset-0 w-full h-full object-cover scale-105"
		/>
		<div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/55 to-black/20"></div>
		<div class="relative w-full max-w-7xl mx-auto px-5 md:px-6 pb-8 md:pb-16 pt-32 flex items-end justify-between gap-8">
			<div>
				<Image src={logo} alt="Panino Focacceria" class="md:hidden w-34 mb-4 drop-shadow-2xl animate-fade-up" />
				<h1 class="animate-fade-up">
					<span class="block text-primary text-5xl md:text-8xl lg:text-9xl font-900 leading-[0.85] tracking-tight">panino</span>
					<span class="block text-white text-lg md:text-3xl font-500 uppercase tracking-[0.4em] mt-2">focacceria</span>
				</h1>
				<p class="text-white font-800 text-xl md:text-3xl mt-5 md:mt-6 animate-fade-up delay-1">Italian Focaccia, Done Properly.</p>
				<p class="text-white/70 text-base md:text-xl max-w-md mt-2 md:mt-3 mb-5 md:mb-6 animate-fade-up delay-2">Every bread, sauce &amp; filling, 100% homemade. Find us at your local market.</p>
				<div class="flex flex-col sm:flex-row gap-3 sm:gap-4 animate-fade-up delay-3">
					<a href="#menu" class="bg-primary text-black px-7 py-3.5 font-bold tracking-wide hover:bg-white transition-colors inline-flex items-center justify-center leading-none">
						See the menu
					</a>
					<a href="/order" class="border-2 border-white/50 text-white px-7 py-3.5 font-bold tracking-wide hover:bg-primary hover:text-black transition-colors inline-flex items-center justify-center leading-none">
						Buy the bread
					</a>
				</div>
			</div>
			<Image src={logo} alt="Panino Focacceria" class="hidden md:block w-64 lg:w-96 animate-fade-up delay-4 drop-shadow-2xl" />
		</div>
	</section>

	<!-- Marquee ticker -->
	<div class="bg-primary py-3">
		<div class="marquee">
			<div class="marquee__item">
				{tickerContent.map((word, i) => (
					<>
						{i > 0 && <div class="size-1.5 bg-black rounded-full shrink-0"></div>}
						<span class="text-black font-bold uppercase tracking-[0.25em] text-sm whitespace-nowrap">{word}</span>
					</>
				))}
				<div class="size-1.5 bg-black rounded-full shrink-0"></div>
			</div>
			<div class="marquee__item" aria-hidden="true">
				{tickerContent.map((word, i) => (
					<>
						{i > 0 && <div class="size-1.5 bg-black rounded-full shrink-0"></div>}
						<span class="text-black font-bold uppercase tracking-[0.25em] text-sm whitespace-nowrap">{word}</span>
					</>
				))}
				<div class="size-1.5 bg-black rounded-full shrink-0"></div>
			</div>
		</div>
	</div>
	</div>

	<!-- Menu -->
	<section id="menu" class="py-14 pt-7 md:py-22 px-5 md:px-6">
		<div class="max-w-6xl mx-auto">
			<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 md:mb-16">
				<div>
					<p class="text-black/40 font-bold uppercase tracking-[0.3em] text-sm mb-3">What we make</p>
					<h2 class="text-4xl md:text-7xl font-900 tracking-tight">The Menu</h2>
				</div>
				<div class="flex justify-center md:justify-end gap-3 md:gap-4">
					<!-- Polaroid 1 -->
					<div class="group bg-white p-1.5 pb-4 shadow-lg -rotate-3 hover:rotate-0 hover:shadow-xl transition-all duration-300 cursor-default w-28 md:w-36 min-w-0">
						<div class="aspect-square overflow-hidden">
							<Image
								src={prosciuttoSandwich}
								alt="Prosciutto focaccia sandwich"
								class="w-full h-full object-cover transition-transform duration-500"
							/>
						</div>
					</div>
					<!-- Polaroid 2 -->
					<div class="group bg-white p-1.5 pb-4 shadow-lg rotate-2 hover:rotate-0 hover:shadow-xl transition-all duration-300 cursor-default w-28 md:w-36 min-w-0 translate-y-3">
						<div class="aspect-square overflow-hidden">
							<Image
								src={capreseSandwich}
								alt="Caprese focaccia sandwich"
								class="w-full h-full object-cover transition-transform duration-500"
							/>
						</div>
					</div>
					<!-- Polaroid 3 -->
					<div class="group bg-white p-1.5 pb-4 shadow-lg -rotate-2 hover:rotate-0 hover:shadow-xl transition-all duration-300 cursor-default w-28 md:w-36 min-w-0 -translate-y-1">
						<div class="aspect-square overflow-hidden">
							<Image
								src={sandwichTrio}
								alt="Three focaccia sandwiches"
								class="w-full h-full object-cover transition-transform duration-500"
							/>
						</div>
					</div>
				</div>
			</div>

			<!-- Full menu -->
			<div class="space-y-8 md:space-y-10">
				<div>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="text-2xl md:text-4xl font-900 min-w-0">&ldquo;Big Paulie&rdquo; <span class="block w-0 overflow-visible whitespace-nowrap md:inline md:w-auto md:whitespace-normal text-xs md:text-lg font-semibold uppercase tracking-[0.2em] text-black/40 mt-1 md:mt-0">Trentino</span></h3>
						<div class="flex-1 border-b-2 border-dotted border-black/15 mb-1.5 md:mb-2 min-w-4"></div>
						<span class="text-sm md:text-base font-bold text-black/15 shrink-0">7.50</span>
					</div>
					<p class="text-black/45 text-sm md:text-base mt-1.5">Grilled chicken breast, spicy &rsquo;nduja salami, provolone cheese, hot honey.</p>
				</div>
				<div>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="text-2xl md:text-4xl font-900 min-w-0">&ldquo;Little Vinnie&rdquo; <span class="block w-0 overflow-visible whitespace-nowrap md:inline md:w-auto md:whitespace-normal text-xs md:text-lg font-semibold uppercase tracking-[0.2em] text-black/40 mt-1 md:mt-0">Mancuso</span></h3>
						<div class="flex-1 border-b-2 border-dotted border-black/15 mb-1.5 md:mb-2 min-w-4"></div>
						<span class="text-sm md:text-base font-bold text-black/15 shrink-0">7.50</span>
					</div>
					<p class="text-black/45 text-sm md:text-base mt-1.5">Prosciutto cotto ham, fresh mozzarella, roasted red peppers, tomato jam.</p>
				</div>
				<div>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="text-2xl md:text-4xl font-900 min-w-0">&ldquo;The Don&rdquo; <span class="block w-0 overflow-visible whitespace-nowrap md:inline md:w-auto md:whitespace-normal text-xs md:text-lg font-semibold uppercase tracking-[0.2em] text-black/40 mt-1 md:mt-0">Godfather of the Lot</span></h3>
						<div class="flex-1 border-b-2 border-dotted border-black/15 mb-1.5 md:mb-2 min-w-4"></div>
						<span class="text-sm md:text-base font-bold text-black/15 shrink-0">7.50</span>
					</div>
					<p class="text-black/45 text-sm md:text-base mt-1.5">Prosciutto &amp; salami, gorgonzola spread, caramelized onion.</p>
				</div>
				<div>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="text-2xl md:text-4xl font-900 min-w-0">&ldquo;The Big Cheese&rdquo; <span class="block w-0 overflow-visible whitespace-nowrap md:inline md:w-auto md:whitespace-normal text-xs md:text-lg font-semibold uppercase tracking-[0.2em] text-black/40 mt-1 md:mt-0">Caprese</span></h3>
						<div class="flex-1 border-b-2 border-dotted border-black/15 mb-1.5 md:mb-2 min-w-4"></div>
						<span class="text-sm md:text-base font-bold text-black/15 shrink-0">7.50</span>
					</div>
					<p class="text-black/45 text-sm md:text-base mt-1.5">Mozzarella &amp; tomatoes, eggplant &amp; roasted pepper spread, pesto &amp; balsamic reduction.</p>
				</div>
				<div>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="text-2xl md:text-4xl font-900 min-w-0">&ldquo;Pretty Boy&rdquo; <span class="block w-0 overflow-visible whitespace-nowrap md:inline md:w-auto md:whitespace-normal text-xs md:text-lg font-semibold uppercase tracking-[0.2em] text-black/40 mt-1 md:mt-0">Rossi</span></h3>
						<div class="flex-1 border-b-2 border-dotted border-black/15 mb-1.5 md:mb-2 min-w-4"></div>
						<span class="text-sm md:text-base font-bold text-black/15 shrink-0">7.50</span>
					</div>
					<p class="text-black/45 text-sm md:text-base mt-1.5">Grilled courgette &amp; portabella mushrooms, artichoke hummus &amp; baby spinach.</p>
				</div>
				<div>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="text-2xl md:text-4xl font-900 min-w-0">&ldquo;Fat Tony&rdquo; <span class="block w-0 overflow-visible whitespace-nowrap md:inline md:w-auto md:whitespace-normal text-xs md:text-lg font-semibold uppercase tracking-[0.2em] text-black/40 mt-1 md:mt-0">Falcone</span></h3>
						<div class="flex-1 border-b-2 border-dotted border-black/15 mb-1.5 md:mb-2 min-w-4"></div>
						<span class="text-sm md:text-base font-bold text-black/15 shrink-0">7.50</span>
					</div>
					<p class="text-black/45 text-sm md:text-base mt-1.5">Italian mortadella, burrata cream, tomatoes, honey garlic vinaigrette.</p>
				</div>
			</div>

			<p class="mt-12 text-black/40 font-bold uppercase tracking-[0.2em] text-sm">Plus a daily special &middot; Ask about today&rsquo;s soup</p>
		</div>
	</section>

	<!-- Soup -->
	<section class="bg-forest py-14 md:py-20 px-5 md:px-6">
		<div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8 md:gap-16">
			<div class="group w-56 md:w-80 shrink-0 bg-primary p-2 md:p-3 shadow-2xl shadow-2xl cursor-default overflow-hidden">
				<Image
					src={soupPhoto}
					alt="Homemade soup with parmesan and pesto"
					class="w-full group-hover:scale-[1.03] transition-transform duration-500"
				/>
			</div>
			<div>
				<p class="text-primary font-bold uppercase tracking-[0.3em] text-sm mb-3">Not just sandwiches</p>
				<h3 class="text-white text-3xl md:text-5xl font-900 tracking-tight mb-4">Soup of the day.</h3>
				<p class="text-white/50 text-base md:text-lg max-w-md leading-relaxed">All homemade, changes every week. Beef &amp; barley, minestrone, tomato&#8209;&#8209;whatever&rsquo;s on, it comes topped with parmesan and pesto.</p>
			</div>
		</div>
	</section>

	<!-- Story -->
	<section id="story" class="relative overflow-hidden">
		<div class="grid md:grid-cols-2 md:min-h-150">
			<div class="relative overflow-hidden h-64 md:h-auto">
				<Image
					src={marketStall}
					alt="Panino Focacceria market stall with sunflowers"
					class="absolute inset-0 w-full h-full object-cover"
				/>
			</div>
			<div class="bg-primary/10 px-5 md:px-16 py-14 md:py-28 flex flex-col justify-center">
				<p class="text-black/40 font-bold uppercase tracking-[0.3em] text-sm mb-4 md:mb-6">Our story</p>
				<h2 class="text-3xl md:text-5xl font-900 leading-tight tracking-tight mb-6 md:mb-8">
					Inspired by <span class="text-primary">Tuscany.</span><br/>Made in <span class="text-primary">Oxfordshire.</span>
				</h2>
				<p class="text-black/60 text-base md:text-lg leading-relaxed max-w-md">Run by a chef with 30&#8209;odd years in professional kitchens around the world. Every bread, sauce and side is made from scratch. Every sandwich is built to order at the stall. Nothing fancy, just simple things done properly.</p>
				<p class="text-black/40 text-base md:text-lg mt-4 italic">We get a lot of regulars.</p>
			</div>
		</div>
	</section>

</Layout>
