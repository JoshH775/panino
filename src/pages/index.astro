---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import logo from '../images/logo.png'
import marketStall from '../images/market-stall.jpg'
import capreseSandwich from '../images/caprese-sandwich.jpg'
import prosciuttoSandwich from '../images/prosciutto-sandwich.jpg'
import sandwichTrio from '../images/sandwich-trio.jpg'

const tickerWords = [
	'Focaccia',
	'Prosciutto',
	'Mozzarella',
	'Caprese',
	'Homemade',
	'Tuscan',
	'Fresh Daily',
	'Market Fresh',
]

const tickerContent = [...tickerWords, ...tickerWords]
---

<Layout>
	<!-- Hero -->
	<section class="relative min-h-[70vh] flex items-end overflow-hidden">
		<Image
			src={prosciuttoSandwich}
			alt="Fresh prosciutto focaccia sandwich close-up"
			class="absolute inset-0 w-full h-full object-cover scale-105"
		/>
		<div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/55 to-black/20"></div>
		<div class="relative w-full max-w-7xl mx-auto px-6 pb-16 pt-32 flex items-end justify-between gap-8">
			<div>
				<h1 class="animate-fade-up">
					<span class="block text-primary text-6xl md:text-8xl lg:text-9xl font-900 leading-[0.85] tracking-tight">panino</span>
					<span class="block text-white text-xl md:text-3xl font-500 uppercase tracking-[0.4em] mt-2">focacceria</span>
				</h1>
				<p class="text-white font-800 text-2xl md:text-3xl mt-6 animate-fade-up delay-1">Italian Focaccia, Done Properly.</p>
				<p class="text-white/70 text-lg md:text-xl max-w-md mt-3 mb-6 animate-fade-up delay-2">Every bread, sauce &amp; filling, 100% homemade. Find us at your local market.</p>
				<div class="flex flex-wrap gap-4 animate-fade-up delay-3">
					<a href="#menu" class="bg-primary text-black px-7 py-3.5 font-bold tracking-wide hover:bg-white transition-colors inline-flex items-center leading-none">
						See the menu
					</a>
					<a href="/order" class="border-2 border-white/50 text-white px-7 py-3.5 font-bold tracking-wide hover:bg-primary hover:text-black transition-colors inline-flex items-center leading-none">
						Buy the bread
					</a>
				</div>
			</div>
			<Image src={logo} alt="Panino Focacceria" class="hidden md:block w-64 lg:w-96 animate-fade-up delay-4 drop-shadow-2xl" />
		</div>
	</section>

	<!-- Marquee ticker -->
	<div class="bg-primary py-3">
		<div class="marquee">
			<div class="marquee__item">
				{tickerContent.map((word, i) => (
					<>
						{i > 0 && <div class="size-1.5 bg-black rounded-full shrink-0"></div>}
						<span class="text-black font-bold uppercase tracking-[0.25em] text-sm whitespace-nowrap">{word}</span>
					</>
				))}
				<div class="size-1.5 bg-black rounded-full shrink-0"></div>
			</div>
			<div class="marquee__item" aria-hidden="true">
				{tickerContent.map((word, i) => (
					<>
						{i > 0 && <div class="size-1.5 bg-black rounded-full shrink-0"></div>}
						<span class="text-black font-bold uppercase tracking-[0.25em] text-sm whitespace-nowrap">{word}</span>
					</>
				))}
				<div class="size-1.5 bg-black rounded-full shrink-0"></div>
			</div>
		</div>
	</div>

	<!-- Menu -->
	<section id="menu" class="py-22 px-6">
		<div class="max-w-6xl mx-auto">
			<div class="mb-16">
				<p class="text-black/40 font-bold uppercase tracking-[0.3em] text-sm mb-3">What we make</p>
				<h2 class="text-5xl md:text-7xl font-900 tracking-tight">The Menu</h2>
			</div>

			<div class="grid md:grid-cols-3 gap-6 md:gap-10">
				<!-- Polaroid 1 -->
				<div class="group bg-white p-3 pb-8 shadow-xl md:-rotate-2 hover:rotate-0 hover:shadow-2xl transition-all duration-300 cursor-default">
					<div class="aspect-square overflow-hidden">
						<Image
							src={prosciuttoSandwich}
							alt="Prosciutto focaccia sandwich"
							class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
						/>
					</div>
					<div class="mt-4 px-1">
						<h3 class="text-2xl font-800 mb-1">Prosciutto</h3>
						<p class="text-black/50 text-sm leading-relaxed">Aged prosciutto, fresh mozzarella, rocket &amp; our house spread on golden focaccia.</p>
					</div>
				</div>

				<!-- Polaroid 2 -->
				<div class="group bg-white p-3 pb-8 shadow-xl md:rotate-1 hover:rotate-0 hover:shadow-2xl transition-all duration-300 md:translate-y-10 cursor-default">
					<div class="aspect-square overflow-hidden">
						<Image
							src={capreseSandwich}
							alt="Caprese focaccia sandwich"
							class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
						/>
					</div>
					<div class="mt-4 px-1">
						<h3 class="text-2xl font-800 mb-1">Caprese</h3>
						<p class="text-black/50 text-sm leading-relaxed">Fresh mozzarella, vine tomato, basil &amp; balsamic glaze. A classic done right.</p>
					</div>
				</div>

				<!-- Polaroid 3 -->
				<div class="group bg-white p-3 pb-8 shadow-xl md:-rotate-1 hover:rotate-0 hover:shadow-2xl transition-all duration-300 cursor-default">
					<div class="aspect-square overflow-hidden">
						<Image
							src={sandwichTrio}
							alt="Selection of focaccia sandwiches"
							class="w-full h-full object-cover object-bottom group-hover:scale-105 transition-transform duration-500"
						/>
					</div>
					<div class="mt-4 px-1">
						<h3 class="text-2xl font-800 mb-1">&amp; More</h3>
						<p class="text-black/50 text-sm leading-relaxed">Mortadella, vegetariano, seasonal specials. The menu changes with the seasons and our mood.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Story -->
	<section id="story" class="relative overflow-hidden">
		<div class="grid md:grid-cols-2 min-h-150">
			<div class="relative overflow-hidden">
				<Image
					src={marketStall}
					alt="Panino Focacceria market stall with sunflowers"
					class="absolute inset-0 w-full h-full object-cover"
				/>
			</div>
			<div class="bg-primary/10 px-8 md:px-16 py-20 md:py-28 flex flex-col justify-center">
				<p class="text-black/40 font-bold uppercase tracking-[0.3em] text-sm mb-6">Our story</p>
				<h2 class="text-4xl md:text-5xl font-900 leading-tight tracking-tight mb-8">
					Inspired by<br/><span class="text-primary">Tuscany.</span><br/>Made in<br/><span class="text-primary">Oxfordshire.</span>
				</h2>
				<p class="text-black/60 text-lg leading-relaxed max-w-md">We offer more than incredible sandwiches. Every bread, sauce and side is 100% homemade and uniquely ours. Premium ingredients, traditional techniques, and a tongue&#8209;in&#8209;cheek sense of fun.</p>
				<p class="text-black/40 text-lg mt-4 italic">One bite, and you'll already be planning the next.</p>
			</div>
		</div>
	</section>

</Layout>
