---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import marketStall from '../images/market-stall.jpg'
import capreseSandwich from '../images/caprese-sandwich.jpg'
import prosciuttoSandwich from '../images/prosciutto-sandwich.jpg'
import sandwichTrio from '../images/sandwich-trio.jpg'
---

<Layout>
	<!-- Hero -->
	<section class="min-h-screen flex flex-col justify-center items-center pt-24 pb-12 px-6 md:px-12 lg:px-24 bg-linear-to-br from-primary/10 to-white">
		<div class="mx-auto grid md:grid-cols-2 gap-12 items-center h-full">
			<!-- Left: Text -->
			<div class="order-2 md:order-1">
				<div class="w-16 h-1 bg-primary mb-6"></div>
				<h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6">Tuscan<br><span class="text-primary">Focaccia</span><br>Sandwiches</h1>
				<p class="text-xl md:text-2xl text-gray-600 mb-8">Fresh at local markets across Oxfordshire</p>
				<a href="#menu" class="bg-primary px-6 py-3 font-semibold hover:bg-primary/80 transition-colors inline-block w-fit">View Menu</a>
			</div>
			<!-- Right: Large circle with smaller image circle -->
			<div class="order-1 md:order-2 relative flex justify-center items-center py-8">
				<!-- Accent circles behind -->
				<div class="absolute -top-4 -right-4 w-1/4 aspect-square rounded-full bg-primary/30"></div>
				<div class="absolute bottom-0 right-0 w-1/3 aspect-square rounded-full bg-primary/20"></div>
				<!-- Small image circle overlapping -->
				<div class="absolute bottom-0 left-0 md:left-4 w-1/3 max-w-52 aspect-square rounded-full overflow-hidden border-4 border-primary shadow-lg z-10">
					<Image src={capreseSandwich} alt="Caprese sandwich" class="w-full h-full object-cover" />
				</div>
				<!-- Main large circle -->
				<div class="w-full max-w-md lg:max-w-xl aspect-square rounded-full overflow-hidden shadow-xl border-4 border-primary">
					<Image src={prosciuttoSandwich} alt="Fresh prosciutto focaccia sandwich" class="w-full h-full object-cover" />
				</div>
			</div>
		</div>
	</section>

	<!-- Menu -->
	<section id="menu" class="py-20 px-6 bg-stone-100">
		<h2 class="text-3xl font-bold text-center mb-12">The Menu</h2>
		<div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8">
			<!-- Sandwich 1 -->
			<div class="bg-white p-4">
				<div class="aspect-square mb-4 overflow-hidden">
					<Image src={prosciuttoSandwich} alt="Prosciutto focaccia sandwich" class="w-full h-full object-cover" />
				</div>
				<h3 class="text-xl font-semibold mb-2">Prosciutto</h3>
				<p class="text-gray-600">Aged prosciutto, fresh mozzarella, rocket on fresh focaccia.</p>
			</div>
			<!-- Sandwich 2 -->
			<div class="bg-white p-4">
				<div class="aspect-square mb-4 overflow-hidden">
					<Image src={capreseSandwich} alt="Caprese focaccia sandwich" class="w-full h-full object-cover" />
				</div>
				<h3 class="text-xl font-semibold mb-2">Caprese</h3>
				<p class="text-gray-600">Fresh mozzarella, tomato, basil, balsamic glaze.</p>
			</div>
			<!-- Sandwich 3 -->
			<div class="bg-white p-4">
				<div class="aspect-square mb-4 overflow-hidden">
					<Image src={sandwichTrio} alt="Selection of focaccia sandwiches" class="w-full h-full object-cover object-bottom" />
				</div>
				<h3 class="text-xl font-semibold mb-2">Vegetariano</h3>
				<p class="text-gray-600">Grilled vegetables, goat cheese, rocket, balsamic glaze.</p>
			</div>
		</div>
	</section>

	<!-- Find Us -->
	<section id="find-us" class="py-20 px-6">
		<div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
			<div class="aspect-video overflow-hidden">
				<Image src={marketStall} alt="Panino Focacceria market stall" class="w-full h-full object-cover" />
			</div>
			<!-- Info -->
			<div>
				<h2 class="text-3xl font-bold mb-6">Find Us</h2>
				<div class="space-y-4">
					<div class="border-l-4 border-primary pl-4">
						<p class="text-xl font-semibold">Bicester Friday Market</p>
						<p class="text-gray-600">Fridays</p>
					</div>
					<div class="border-l-4 border-primary pl-4">
						<p class="text-xl font-semibold">Kidlington</p>
						<p class="text-gray-600">Saturdays</p>
					</div>
					<div class="border-l-4 border-primary pl-4">
						<p class="text-xl font-semibold">Thame</p>
						<p class="text-gray-600">Tuesdays</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Instagram -->
	<section class="py-20 px-6 bg-stone-50">
		<div class="max-w-6xl mx-auto">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
				<div class="aspect-square overflow-hidden">
					<Image src={prosciuttoSandwich} alt="Prosciutto sandwich" class="w-full h-full object-cover hover:scale-105 transition-transform" />
				</div>
				<div class="aspect-square overflow-hidden">
					<Image src={capreseSandwich} alt="Caprese sandwich" class="w-full h-full object-cover hover:scale-105 transition-transform" />
				</div>
				<div class="aspect-square overflow-hidden">
					<Image src={marketStall} alt="Market stall" class="w-full h-full object-cover hover:scale-105 transition-transform" />
				</div>
				<div class="aspect-square overflow-hidden">
					<Image src={sandwichTrio} alt="Sandwich selection" class="w-full h-full object-cover hover:scale-105 transition-transform" />
				</div>
			</div>
			<p class="text-center">
				<a
					href="https://instagram.com/paninofocacceria"
					target="_blank"
					class="text-lg font-semibold bg-primary px-4 py-2 hover:bg-primary/80 transition-colors inline-block"
				>
					@paninofocacceria
				</a>
			</p>
		</div>
	</section>
</Layout>
